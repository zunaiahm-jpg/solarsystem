{
  "buildCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/api/teacher-register", "destination": "/api/education/teacher-register" },
    { "source": "/api/teacher-login", "destination": "/api/education/teacher-login" },
    { "source": "/api/teacher-session", "destination": "/api/education/teacher-session" },
    { "source": "/api/teacher-logout", "destination": "/api/education/teacher-logout" },
    { "source": "/api/education-classes", "destination": "/api/education/education-classes" },
    { "source": "/api/education-students", "destination": "/api/education/education-students" },
    { "source": "/api/join-class", "destination": "/api/education/join-class" },
    { "source": "/api/mission-attempts", "destination": "/api/education/mission-attempts" },
    { "source": "/api/class-results", "destination": "/api/education/class-results" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), xr-spatial-tracking=(self)" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/spaceedu/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
